# ─── LLM provider ─────────────────────────────────────────────────────────────
# "anthropic" (default, production) or "openai" (any OpenAI-compatible endpoint:
# Ollama, LM Studio, llama.cpp, vLLM — handy for local testing / self-hosting).
LLM_PROVIDER=anthropic

# ─── Anthropic (required when LLM_PROVIDER=anthropic) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Primary chat model. Options: claude-sonnet-4-6 (default), claude-opus-4-8, claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── OpenAI-compatible (required when LLM_PROVIDER=openai) ────────────────────
# Ollama example: base URL http://localhost:11434/v1, model e.g. llama3.2 / qwen2.5
# LM Studio example: base URL http://localhost:1234/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5
# Most local servers ignore the key; leave the default if not needed.
OPENAI_API_KEY=not-needed

# ─── BigCommerce (store API account) ──────────────────────────────────────────
# From: Store Settings → API → Store-level API accounts.
# Scopes required: Products (read-only), Orders (read-only).
# Set MOCK_BIGCOMMERCE=true to run with built-in sample catalog/order data and
# no real store (local testing). When true, the two BC_ vars are optional.
MOCK_BIGCOMMERCE=false
BC_STORE_HASH=abc123
BC_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated list of storefront origins allowed to call the API.
ALLOWED_ORIGINS=https://your-store.example.com,https://www.your-store.example.com

# ─── Human handoff (at least one channel recommended) ─────────────────────────
# Email escalation (SMTP). Leave blank to disable.
ESCALATION_EMAIL=support@your-store.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=chatbot@your-store.example.com
# Slack incoming-webhook URL. Leave blank to disable.
SLACK_WEBHOOK_URL=
